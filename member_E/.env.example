# 成员 E AI Provider（阶段二·任务一）
# 复制为 .env 后填入真实 Key；勿提交含密钥的 .env 文件。

OPENAI_API_KEY=
AI_PROVIDER=auto
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=15000
AI_BASE_URL=https://api.openai.com/v1

# ============================================================
# DeepSeek 配置（复制到 backend/.env 后填入 key）
# ============================================================
# 1. 取消下面 5 行的注释
# 2. 把 YOUR_DEEPSEEK_API_KEY_HERE 换成你的真实 key
# 3. 不要把包含真实 key 的 .env 提交到 Git
# ============================================================
# AI_PROVIDER=openai
# AI_API_KEY=YOUR_DEEPSEEK_API_KEY_HERE
# AI_BASE_URL=https://api.deepseek.com
# AI_MODEL=deepseek-v4-flash
# AI_TIMEOUT_MS=30000

# ============================================================
# GLM Vision 配置
# ============================================================
# 图片理解使用智谱 GLM，DeepSeek 继续负责文字生成。
# 真实 key 只放 backend/.env，不要提交到 Git。
# ============================================================
# VISION_PROVIDER=glm
# ZHIPU_API_KEY=YOUR_ZHIPU_API_KEY_HERE
# ZHIPU_API_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# ZHIPU_VISION_MODEL=glm-4v-flash
# ZHIPU_VISION_TIMEOUT_MS=45000
# ZHIPU_VISION_MAX_IMAGE_BYTES=20971520
